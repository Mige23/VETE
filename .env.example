# Copiá este archivo como .env y reemplazá únicamente los valores.
# Nunca subas .env a Git ni lo compartas por chat.
GEMINI_API_KEY=REEMPLAZAR_CON_UNA_CLAVE_NUEVA
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=900

# Generar con: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CHAT_SIGNING_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS

# Dominio final, sin barra al final.
ALLOWED_ORIGIN=https://tudominio.com

CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_RATE_LIMIT_5M=8
CHAT_RATE_LIMIT_DAY=40

